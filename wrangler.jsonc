{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fio-uhrady",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Přepisuje se při nasazení: wrangler deploy --var GIT_COMMIT:<hash> (viz scripts/deploy.mjs)
  "vars": {
    "GIT_COMMIT": "dev",
    // Únik do adminu jen pro lokální vývoj; v kódu navíc platí pouze na localhostu.
    // V produkci zůstává "0" a admin pustí jedině Cloudflare Access.
    "DEV_ADMIN": "0"
  },

  // Vytvořit: wrangler d1 create fio-uhrady → vrácené database_id doplnit sem.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fio-uhrady",
      "database_id": "7f116705-6320-4ea2-9f89-5722800d8efa"
    }
  ],

  // Workers AI — free backend pro komentář k vývoji nákladů a čtení účtenek.
  // Data neopustí Cloudflare a free tarif dá 10 000 neuronů denně. Placený Claude
  // je volitelný přes ANTHROPIC_API_KEY; bez klíče appka sama nikdy neutrácí.
  "ai": { "binding": "AI" },

  // Stahování pohybů z Fio: limit Fio API je 1 dotaz / 30 s, 15 minut je s rezervou.
  // Slot se uvolnil vypnutím cronů u nepoužívaného rezervace-app (2026-08-19);
  // účet bass443 má free limit 5 cron triggerů, další by skončil na chybě 10072.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }

  // FIO_TOKEN je secret: wrangler secret put FIO_TOKEN (lokálně .dev.vars)
}
